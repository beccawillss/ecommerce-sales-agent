# Evaluation traces are enabled by default for local development.
# Set this to false in production-style deployments to remove the trace route.
SALESAGENT_ENABLE_EVAL_TRACES=true

# Required only for live chat requests. Import, health, and offline tests need no key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_SECONDS=30
